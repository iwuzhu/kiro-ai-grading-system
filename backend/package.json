{
    "name": "ai-grading-system-backend",
    "version": "1.0.0",
    "description": "NestJS-based REST API for AI Grading System",
    "author": "TEC-BridgeAI Team",
    "private": true,
    "license": "MIT",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "typeorm-ts-node-esm",
        "typeorm:cli": "typeorm-ts-node-esm",
        "typeorm:migration:generate": "typeorm migration:generate",
        "typeorm:migration:run": "typeorm migration:run",
        "typeorm:migration:revert": "typeorm migration:revert",
        "typeorm:migration:show": "typeorm migration:show",
        "db:migrate": "npm run typeorm:migration:run",
        "db:migrate:revert": "npm run typeorm:migration:revert",
        "db:migrate:show": "npm run typeorm:migration:show"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1146.0",
        "@aws-sdk/client-secrets-manager": "^3.1146.0",
        "@aws-sdk/s3-request-presigner": "^3.1146.0",
        "@nestjs/common": "^10.3.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.0",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^10.0.0",
        "@nestjs/platform-express": "^10.3.0",
        "@nestjs/typeorm": "^10.0.0",
        "@types/express": "^4.17.21",
        "axios": "^1.20.0",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "dotenv": "^16.3.1",
        "joi": "^17.11.0",
        "mammoth": "^1.13.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pdfjs-dist": "^6.4.299",
        "pg": "^8.11.3",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^5.0.5",
        "rxjs": "^7.8.1",
        "sharp": "^0.35.5",
        "typeorm": "^0.3.18"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^10.3.0",
        "@nestjs/schematics": "^10.0.3",
        "@nestjs/testing": "^10.3.0",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.6",
        "@types/passport-jwt": "^3.0.11",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.12.0",
        "jest": "^29.7.0",
        "jiti": "^2.7.0",
        "prettier": "^3.1.1",
        "ts-jest": "^29.1.1",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.70.1"
    }
}
