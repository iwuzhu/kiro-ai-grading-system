{
  "mcpServers": {
    "aws-docs": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@latest"],
      "env": { "FASTMCP_LOG_LEVEL": "ERROR" },
      "disabled": false
    },
    "web-search": {
      "command": "uvx",
      "args": ["web-search-mcp@latest"],
      "disabled": false
    },
    "github": {
      "command": "uvx",
      "args": ["github-mcp-server@latest"],
      "disabled": false
    }
  }
}
